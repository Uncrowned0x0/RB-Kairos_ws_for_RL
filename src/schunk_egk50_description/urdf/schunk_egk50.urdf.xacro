<?xml version="1.0"?>
<!--
  Schunk EGK 50-MB-M-B Parallel Gripper
  ======================================
  Updated with articulated fingers and support.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="schunk_egk50_gripper" params="parent prefix:='schunk_' *origin">

    <!-- ================================================================= -->
    <!-- Gripper base link (rigidly attached to the arm flange)             -->
    <!-- ================================================================= -->
    <link name="${prefix}base_link">
      <inertial>
        <!-- Combined mass: 1.870 kg (base) + 0.200 kg (support) = 2.070 kg -->
        <mass value="2.070"/>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <inertia ixx="0.0021" ixy="0.0" ixz="0.0" iyy="0.0031" iyz="0.0" izz="0.0011"/>
      </inertial>

      <!-- Visual 1: Schunk Gripper Body -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find schunk_egk50_description)/meshes/visual/schunkv1.stl" scale="1 1 1"/>
        </geometry>
        <material name="schunk_dark_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>

      <!-- Visual 2: Support Plate -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find schunk_egk50_description)/meshes/visual/support_schunk.stl" scale="1 1 1"/>
        </geometry>
        <material name="schunk_light_grey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>

      <!-- Single Merged Collision Box (Base + Support combined) -->
      <collision>
        <origin xyz="0 0.0515 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.0785 0.1014 0.147"/>
        </geometry>
      </collision>
    </link>

    <!-- Dummy link to attach to parent and apply 90 degree rotation -->
    <link name="${prefix}mount_link"/>

    <joint name="${prefix}mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}mount_link"/>
    </joint>

    <joint name="${prefix}base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <parent link="${prefix}mount_link"/>
      <child link="${prefix}base_link"/>
    </joint>


    <!-- ================================================================= -->
    <!-- Fingers                                                            -->
    <!-- ================================================================= -->
    <link name="${prefix}left_finger_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find schunk_egk50_description)/meshes/visual/pince1.stl" scale="1 1 1"/>
        </geometry>
        <material name="schunk_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0.1975 -0.0317" rpy="0 0 0"/>
        <geometry>
          <box size="0.011 0.0194 0.010"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}left_finger_joint" type="prismatic">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}left_finger_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.01" upper="0.033" velocity="0.191" effort="150"/>
    </joint>

    <link name="${prefix}right_finger_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find schunk_egk50_description)/meshes/visual/pince2.stl" scale="1 1 1"/>
        </geometry>
        <material name="schunk_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0.198 0.04470" rpy="0 0 0"/>
        <geometry>
          <box size="0.011 0.0194 0.010"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}right_finger_joint" type="prismatic">
      <origin xyz="0 -0.0005 0.0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}right_finger_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.01" upper="0.033" velocity="0.191" effort="150"/>
    </joint>

    <!-- ================================================================= -->
    <!-- TCP (Tool Center Point)                                            -->
    <!-- ================================================================= -->
    <link name="${prefix}tcp_link">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}tcp_link"/>
    </joint>

    <!-- ================================================================= -->
    <!-- Gazebo material overrides                                          -->
    <!-- ================================================================= -->
    <gazebo reference="${prefix}base_link">
      <material>Gazebo/DarkGrey</material>
      <self_collide>0</self_collide>
    </gazebo>

    <gazebo reference="${prefix}left_finger_link">
      <material>Gazebo/Black</material>
      <self_collide>0</self_collide>
    </gazebo>
    <gazebo reference="${prefix}right_finger_link">
      <material>Gazebo/Black</material>
      <self_collide>0</self_collide>
    </gazebo>

    <!-- ================================================================= -->
    <!-- ROS2 Control for Gripper Joints                                    -->
    <!-- ================================================================= -->
    <ros2_control name="${prefix}gripper_hardware" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <!-- Left finger: commanded -->
      <joint name="${prefix}left_finger_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.033</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <!-- Right finger: commanded -->
      <joint name="${prefix}right_finger_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.033</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
